# Jerry local env (copy to `.env` — gitignored).
# Loaded automatically by `jerry` CLI and `pnpm dev` (walks up from cwd).

JERRY_URL=http://127.0.0.1:8787
JERRY_RUNTIME=local
JERRY_MODEL=ollama:qwen2.5:3b
# Required for Drive / YouTube tools (or pass --approve, which forces this):
# JERRY_EGRESS=allow-tools

# Ozwell
# OZWELL_API_KEY=ozw_...
# OZWELL_ENDPOINT=https://ozwellapi.os.mieweb.org

# BYO-cloud / Anthropic / OpenAI
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Google Drive + YouTube OAuth (worker must restart after changes)
# Create Web OAuth client; redirect URI must match exactly:
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8787/v1/oauth/google/callback
# Paste output of: openssl rand -hex 32  (64 hex chars — do NOT leave $(...) unexpanded)
JERRY_OAUTH_ENCRYPTION_KEY=
