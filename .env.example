# Jerry — example environment for API / cloud runtimes.
# Copy to `.env` in the repo root and fill in what you need:
#
#   cp .env.example .env
#
# The CLI loads `.env` automatically (from cwd or a parent directory).
# Shell-exported variables still win over values in this file.
# Local Ollama needs no keys — leave cloud vars blank if you stay local.

# Worker URL (default is fine for `pnpm dev`)
JERRY_URL=http://127.0.0.1:8787

# Runtime: local | ozwell | byo-cloud
JERRY_RUNTIME=local

# Examples:
# JERRY_MODEL=ollama:qwen2.5:3b
# JERRY_MODEL=gpt-4.1-mini
# JERRY_MODEL=https://api.openai.com/v1#gpt-4o
# JERRY_MODEL=https://api.anthropic.com/v1#claude-sonnet-5
# JERRY_EGRESS=deny

# --- Ozwell (prefer parent key ozw_… ; avoid agnt_key- for Jerry tools) ---
# OZWELL_API_KEY=ozw_your_key
# OZWELL_ENDPOINT=https://ozwellapi.os.mieweb.org
# OZWELL_AGENT_KEY=

# --- BYO-cloud / catalog models ---
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# JERRY_API_KEY=

# Optional: resume a session with bare `jerry`
# JERRY_SESSION=
